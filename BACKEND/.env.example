# Application
PROJECT_NAME="Fish POS Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-this-with-a-secure-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="fish_pos_db"
DATABASE_URL="postgresql://postgres:password@localhost:5432/fish_pos_db"

# Store & POS Defaults
DEFAULT_STORE_CODE="STORE-001"
DEFAULT_STORE_NAME="Main Harbor Fish Outlet"
DEFAULT_CURRENCY="INR"
DEFAULT_TAX_RATE=5.0
AUTO_RESERVE_ONLINE_STOCK=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
